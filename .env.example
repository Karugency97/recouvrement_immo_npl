# ===========================================
# IMMO NPL — Variables d'environnement
# ===========================================
# Copier ce fichier :
#   cp .env.example .env                        (racine, pour scripts Directus)
#   cp .env.example apps/frontend/.env.local     (frontend Next.js)

# ------ Frontend (Next.js) ------
# URL publique de l'instance Directus (accessible depuis le navigateur)
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# ------ Scripts Directus (setup-schema, setup-roles, seed) ------
# URL interne de l'instance Directus
DIRECTUS_URL=http://localhost:8055

# Token statique admin Directus (Settings > Access Tokens dans Directus)
DIRECTUS_ADMIN_TOKEN=your-admin-static-token

# ------ Auth ------
# Secret pour la signature (utilise par le middleware auth)
AUTH_SECRET=your-auth-secret-here

# ===========================================
# Stack S1 — Convex + Logto + SECIB
# ===========================================
# Cf. PLAN_V1.md, MIGRATION_DIRECTUS_TO_CONVEX.md
# Infra provisionnee 2026-05-27 sur Coolify, projet NPL.

# ------ Convex self-hosted (browser-facing) ------
NEXT_PUBLIC_CONVEX_URL=https://convex.immo.nplavocat.com

# ------ Convex CLI (deploy depuis local / CI) ------
# Recuperer la cle admin depuis le dashboard : https://admin.immo.nplavocat.com
CONVEX_SELF_HOSTED_URL=https://convex.immo.nplavocat.com
CONVEX_SELF_HOSTED_ADMIN_KEY=your-convex-admin-key

# ------ Logto NPL (auth) ------
# Endpoints (Logto self-hosted dedie au projet NPL)
NEXT_PUBLIC_LOGTO_ENDPOINT=https://auth.nplavocat.com
# App SPA "Immonpl Frontend" (id provisionne 2026-05-27)
NEXT_PUBLIC_LOGTO_APP_ID=hg2kdgwrvcg7l2xx86omc
# Ressource API protegee = le backend Convex
NEXT_PUBLIC_LOGTO_RESOURCE=https://convex.immo.nplavocat.com

# ------ SECIB gateway (cote serveur uniquement, JAMAIS exposer cote client) ------
# Cette cle est configuree dans Convex env vars (npx convex env set), pas dans le frontend.
# Voir convex/README.md pour le rationale.
# SECIB_GATEWAY_API_KEY=gw_sl_xxx (NE JAMAIS prefixer NEXT_PUBLIC_)
# SECIB_GATEWAY_BASE_URL=https://apisecib.nplavocat.com/api/v1
